# Variable de Entorno para Habilitar Menú y UI de Personal en Producción
SetEnv TIC_SIGE_PERSONAL_UI_ENABLED 1
SetEnv SIGE_INBOUND_API_KEY l03cced09c86029cf38534ec54a4
SetEnv SIGE_OUTBOUND_API_KEY l03cced09c86029cf38534ec54a4

# Turn rewrite engine on
Options +FollowSymlinks
RewriteEngine on

# Excepciones para archivos y directorios físicos existentes
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# map neat URL to internal URL
RewriteRule 	^acuse.php$ acuse.php [L,QSA]
RewriteRule 	^AcuseConfirmacion/?$  developer/Controller/loginController.php?case=ConfirmarAcuseRecibo [nc,qsa,L]
RewriteRule 	^RecuperarCuenta/(\w+)/?$  cambiarpasswor.php?x=$1 [nc,qsa]
RewriteRule 	^ValidarEmailReal/(\w+)/?$  confirmaremail.php?x=$1 [nc,qsa]
RewriteRule 	^AcuseRecibo/?$  confirmar_recibo.php [nc,qsa,L]
RewriteRule 	^confirmar_recibo/?$  confirmar_recibo.php [nc,qsa,L]

# map neat URL to internal URL
RewriteRule 	^clogin/(\w+)/?$  developer/codelogin.php?case=$1 [nc,qsa]
RewriteRule 	^dashboard  dashboard.php  [nc,qsa]
RewriteRule 	^login  login.php  [nc,qsa]
RewriteRule 	^inscripcionlinea  			inscripcionlinea.php  [nc,qsa]
RewriteRule 	^inscribete        			inscribete.php  [nc,qsa]
RewriteRule 	^preinscripcion   		    preinscripcion.php  [nc,qsa]
RewriteRule 	^crearempresa      			crearempresa.php  [nc,qsa]
RewriteRule 	^alternancia       			alternancia.php  [nc,qsa]
RewriteRule 	^Registraralternancia       Registraralternancia.php  [nc,qsa]
RewriteRule 	^alternanciaArticulacion    alternanciaArticulacion.php  [nc,qsa]
RewriteRule 	^ConfirmarEntrega/?$  acuse.php  [nc,qsa,L]
RewriteRule 	^Verificacion  verificarCarnet.php  [nc,qsa]

RewriteRule 	^Menu  component/menu2.php  [nc,qsa]

