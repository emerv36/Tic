{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tic.scv.edu.co/contracts/personal/v1/persona-command.schema.json",
  "title": "Comando de persona TIC a SIGE",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id_operacion", "tipo", "persona_uuid", "expected_persona_version", "persona", "ocurrido_en", "usuario"],
  "properties": {
    "contract_version": { "const": "1.0" },
    "id_operacion": { "$ref": "#/$defs/uuid" },
    "tipo": { "enum": ["PERSONA_CREAR", "PERSONA_ACTUALIZAR"] },
    "persona_uuid": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
    "expected_persona_version": { "type": "integer", "minimum": 0 },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tipo_documento", "numero_documento", "nombres", "apellidos", "celular", "rh"],
      "properties": {
        "tipo_documento": { "type": "string", "minLength": 1, "maxLength": 20 },
        "numero_documento": { "type": "string", "minLength": 3, "maxLength": 50 },
        "nombres": { "type": "string", "minLength": 1, "maxLength": 150 },
        "apellidos": { "type": "string", "minLength": 1, "maxLength": 150 },
        "celular": { "type": "string", "pattern": "^3[0-9]{9}$" },
        "rh": { "enum": ["O+", "O-", "A+", "A-", "B+", "B-", "AB+", "AB-"] },
        "correo": { "oneOf": [{ "type": "string", "format": "email", "maxLength": 190 }, { "type": "null" }] }
      }
    },
    "ocurrido_en": { "$ref": "#/$defs/dateTimeBogota" },
    "usuario": { "$ref": "#/$defs/usuarioCarnetizacion" }
  },
  "allOf": [
    {
      "if": { "properties": { "tipo": { "const": "PERSONA_CREAR" } } },
      "then": { "properties": { "persona_uuid": { "type": "null" }, "expected_persona_version": { "const": 0 } } },
      "else": { "properties": { "persona_uuid": { "$ref": "#/$defs/uuid" }, "expected_persona_version": { "type": "integer", "minimum": 1 } } }
    }
  ],
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "dateTimeBogota": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$" },
    "usuarioCarnetizacion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nombre", "rol"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "nombre": { "type": "string", "minLength": 1, "maxLength": 190 },
        "rol": { "const": "CARNETIZACION" }
      }
    }
  }
}
