{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tic.scv.edu.co/contracts/personal/v1/vinculo-command.schema.json",
  "title": "Comando de vínculo institucional TIC a SIGE",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id_operacion", "tipo", "persona_uuid", "expected_persona_version", "vinculo", "ocurrido_en", "usuario"],
  "properties": {
    "contract_version": { "const": "1.0" },
    "id_operacion": { "$ref": "#/$defs/uuid" },
    "tipo": { "enum": ["VINCULO_CREAR", "VINCULO_ACTUALIZAR"] },
    "persona_uuid": { "$ref": "#/$defs/uuid" },
    "expected_persona_version": { "type": "integer", "minimum": 1 },
    "vinculo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vinculo_uuid", "tipo", "cargo", "dependencia"],
      "properties": {
        "vinculo_uuid": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "tipo": { "enum": ["DOCENTE", "ADMINISTRATIVO"] },
        "cargo": { "oneOf": [{ "$ref": "#/$defs/catalogo" }, { "type": "null" }] },
        "dependencia": { "oneOf": [{ "$ref": "#/$defs/catalogo" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "tipo": { "const": "ADMINISTRATIVO" } } },
          "then": { "properties": { "cargo": { "$ref": "#/$defs/catalogo" }, "dependencia": { "$ref": "#/$defs/catalogo" } } },
          "else": { "properties": { "cargo": { "type": "null" }, "dependencia": { "type": "null" } } }
        }
      ]
    },
    "ocurrido_en": { "$ref": "#/$defs/dateTimeBogota" },
    "usuario": { "$ref": "#/$defs/usuarioCarnetizacion" }
  },
  "allOf": [
    {
      "if": { "properties": { "tipo": { "const": "VINCULO_CREAR" } } },
      "then": { "properties": { "vinculo": { "properties": { "vinculo_uuid": { "type": "null" } } } } },
      "else": { "properties": { "vinculo": { "properties": { "vinculo_uuid": { "$ref": "#/$defs/uuid" } } } } }
    }
  ],
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "dateTimeBogota": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$" },
    "catalogo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nombre_snapshot", "version"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "nombre_snapshot": { "type": "string", "minLength": 1, "maxLength": 190 },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "usuarioCarnetizacion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nombre", "rol"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "nombre": { "type": "string", "minLength": 1, "maxLength": 190 },
        "rol": { "const": "CARNETIZACION" }
      }
    }
  }
}
