{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tic.scv.edu.co/contracts/personal/v1/foto-command.schema.json",
  "title": "Metadatos idempotentes de fotografía de personal",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id_operacion", "tipo", "persona_uuid", "expected_persona_version", "archivo", "ocurrido_en", "usuario"],
  "properties": {
    "contract_version": { "const": "1.0" },
    "id_operacion": { "$ref": "#/$defs/uuid" },
    "tipo": { "const": "FOTO_ASOCIAR" },
    "persona_uuid": { "$ref": "#/$defs/uuid" },
    "expected_persona_version": { "type": "integer", "minimum": 1 },
    "archivo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campo_multipart", "sha256", "mime_declarado", "bytes"],
      "properties": {
        "campo_multipart": { "const": "foto" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "mime_declarado": { "enum": ["image/jpeg", "image/png"] },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 5242880 }
      }
    },
    "ocurrido_en": { "$ref": "#/$defs/dateTimeBogota" },
    "usuario": { "$ref": "#/$defs/usuarioCarnetizacion" }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "dateTimeBogota": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$" },
    "usuarioCarnetizacion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nombre", "rol"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "nombre": { "type": "string", "minLength": 1, "maxLength": 190 },
        "rol": { "const": "CARNETIZACION" }
      }
    }
  }
}

